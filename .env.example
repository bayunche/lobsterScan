# ---- LLM Provider ----
# 任意选一种，Secrets 页 / 这里二选一即可（Secrets 优先）
LLM_PROVIDER=anthropic              # anthropic | minimax | qwen | glm | openai

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_COORDINATOR_MODEL=claude-opus-4-7

# MiniMax（同时给 LLM 和 TTS 用）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_LLM_MODEL=abab7-chat-preview
MINIMAX_TTS_MODEL=speech-02-hd

# 其它备选
QWEN_API_KEY=
QWEN_LLM_MODEL=qwen3-max
GLM_API_KEY=
GLM_LLM_MODEL=glm-4.5
OPENAI_API_KEY=

# ---- OpenClaw ----
# 注意：openclaw onboard 实际可能监听不同端口（用 `ss -tlnp | grep openclaw` 确认）
# 管台 health 接口会自动探测 7800 / 18789 / 18888 / 8788
OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_HOME=~/.openclaw

# Channel Plugin
HUIHUIBAO_CHANNEL_LISTEN=127.0.0.1:7860

# ---- TTS / 数字人 ----
# video_provider: heygen | self-hosted
VIDEO_PROVIDER=heygen
# tts_provider: minimax | heygen-builtin | elevenlabs | qwen3 | huihuibao
TTS_PROVIDER=minimax
TTS_MODEL=speech-02-hd

HEYGEN_API_KEY=
ELEVENLABS_API_KEY=
QWEN_TTS_ENDPOINT=

# ---- 业务后端 ----
WEB_BACKEND_HOST=0.0.0.0
WEB_BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/tasks.db

# ---- 管理后端 ----
ADMIN_BACKEND_HOST=0.0.0.0
ADMIN_BACKEND_PORT=8100
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=change-me

# ---- 前端 ----
NEXT_PUBLIC_WEB_API_BASE=http://localhost:8000
NEXT_PUBLIC_ADMIN_API_BASE=http://localhost:8100
