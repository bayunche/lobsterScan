# ──────────────────────────────────────────────────────────────────────────
# LLM Provider / 模型 / API Key — 现在全部走管台,本地无需配置
# ──────────────────────────────────────────────────────────────────────────
# 启动后到管台配置:
#   http://localhost:3100/admin/secrets   ← API key(加密存到 data/admin.db)
#   http://localhost:3100/admin/config    ← provider 选哪家 + 模型 ID
#
# 管台改完下一个 agent turn 立即生效,**不需要重启 web-backend**。
# 下面这些 env 仅作"管台还没起 / 初装兜底"用,长期可全部留空或删除。
# 同名 key 同时存在于管台和 .env 时,**管台优先**。
# ──────────────────────────────────────────────────────────────────────────

# 可选 · 兜底 provider(管台 providers.default 缺失才用这条)
LLM_PROVIDER=                       # anthropic | minimax | qwen | glm | openai | deepseek

# 可选 · 各 provider 默认模型(管台 providers.<name>.model 缺失才用这条)
ANTHROPIC_DEFAULT_MODEL=
ANTHROPIC_COORDINATOR_MODEL=
MINIMAX_LLM_MODEL=
MINIMAX_TTS_MODEL=
QWEN_LLM_MODEL=
GLM_LLM_MODEL=
DEEPSEEK_LLM_MODEL=
# DeepSeek 注:OpenAI 兼容,base_url=https://api.deepseek.com,model=deepseek-chat / deepseek-reasoner

# 可选 · API key(管台 secrets 缺失才用这条;生产环境**强烈建议只在管台填**)
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
QWEN_API_KEY=
GLM_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ---- OpenClaw ----
# 注意：openclaw onboard 实际可能监听不同端口（用 `ss -tlnp | grep openclaw` 确认）
# 管台 health 接口会自动探测 7800 / 18789 / 18888 / 8788
OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_HOME=~/.openclaw

# ---- v2 群聊 harness 研发开关(P5,默认值即可,无需改)----
# V2_PROMPT_MODE: legacy(默认,=P4 行为) | envelope(transcript 感知 + speak/silent/done 信封契约)
# V2_TRANSCRIPT_K: envelope 模式注入 prompt 的最近群聊发言条数上限(默认 8)
# V2_PROMPT_MODE=legacy
# V2_TRANSCRIPT_K=8

# Channel Plugin
HUIHUIBAO_CHANNEL_LISTEN=127.0.0.1:7860

# ──────────────────────────────────────────────────────────────────────────
# TTS / 数字人 / 图像 / 音乐 — 同样走管台 http://localhost:3100/admin/config
# ──────────────────────────────────────────────────────────────────────────
# 管台写到 openclaw.json 的 tts / video / image / music 节点,web-backend 每次读真值。
# 下面这些仅作初装兜底,长期可留空。

VIDEO_PROVIDER=                     # heygen | minimax | klingai | self-hosted
TTS_PROVIDER=                       # minimax | heygen-builtin | elevenlabs | qwen3 | huihuibao
TTS_MODEL=

# 第三方密钥(同 LLM 段,优先在管台 secrets 填)
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=
QWEN_TTS_ENDPOINT=

# ---- 业务后端 ----
WEB_BACKEND_HOST=0.0.0.0
WEB_BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/tasks.db

# ---- 管理后端 ----
ADMIN_BACKEND_HOST=0.0.0.0
ADMIN_BACKEND_PORT=8100
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=change-me

# ---- 前端 ----
NEXT_PUBLIC_WEB_API_BASE=http://localhost:8000
NEXT_PUBLIC_ADMIN_API_BASE=http://localhost:8100
